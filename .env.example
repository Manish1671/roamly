# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=roamly
POSTGRES_PASSWORD=roamly
POSTGRES_DB=roamly
POSTGRES_PORT=5434

# Prisma / API (match Compose credentials; host port 5434 → container 5432)
DATABASE_URL=postgresql://roamly:roamly@localhost:5434/roamly?schema=public

# --- API (@roamly/api) ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SESSION_SECRET=change-me-to-at-least-32-random-characters-for-local-dev
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# --- Web (@roamly/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
